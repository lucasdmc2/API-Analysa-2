# Environment Configuration
ENVIRONMENT=development
DEBUG=true

# Security
SECRET_KEY=your-super-secret-key-here-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Database
DATABASE_URL=postgresql://clinical_user:clinical_pass@localhost:5432/clinical_db
DB_ECHO=false

# Redis Cache
REDIS_URL=redis://localhost:6379/0

# AWS Configuration (for S3 storage)
AWS_REGION=us-east-1
S3_BUCKET_NAME=clinical-extraction-dev
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# OCR Configuration
OCR_SERVICE=tesseract
OCR_CONFIDENCE_THRESHOLD=0.8

# Processing Configuration
MAX_FILE_SIZE_MB=50
PIPELINE_VERSION=1.0.0
PROCESSING_TIMEOUT_SECONDS=300

# Rate Limiting
RATE_LIMIT_PER_HOUR=1000

# Logging
LOG_LEVEL=INFO
STRUCTURED_LOGGING=true

# OAuth2/OIDC (Mock values for development)
OAUTH2_TOKEN_URL=https://auth.clinical-extraction.com/oauth/token
OAUTH2_AUDIENCE=clinical-extraction-api
OAUTH2_ISSUER=https://auth.clinical-extraction.com